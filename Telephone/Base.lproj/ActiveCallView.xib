<?xml version='1.0' encoding='UTF-8'?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25087" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25087" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ActiveCallViewController">
            <connections>
                <outlet property="callProgressIndicator" destination="57" id="58" />
                <outlet property="displayedNameField" destination="59" id="129" />
                <outlet property="hangUpButton" destination="122" id="125" />
                <outlet property="statusField" destination="61" id="130" />
                <outlet property="view" destination="41" id="124" />
                <outlet property="numberField" destination="number" id="number-outlet" />
                <outlet property="durationField" destination="duration" id="duration-outlet" />
                <outlet property="muteButton" destination="mute" id="mute-outlet" />
                <outlet property="extensionTransferButton" destination="transfer" id="transfer-outlet" />
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <customView id="41" userLabel="Active Call View" customClass="AKActiveCallView">
            <rect key="frame" x="0.0" y="0.0" width="480" height="190" />
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
            <subviews>
                <textField focusRingType="none" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="59" horizontalCompressionResistancePriority="250">
                    <rect key="frame" x="18" y="45" width="105" height="19" />
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" sendsActionOnEndEditing="YES" title="Display Name" id="60">
                        <font key="font" metaFont="systemBold" size="15" />
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="callController.contactName" id="127" />
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="61" horizontalCompressionResistancePriority="250">
                    <rect key="frame" x="18" y="25" width="43" height="16" />
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" sendsActionOnEndEditing="YES" title="Status" id="62">
                        <font key="font" metaFont="system" />
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="callController.status" id="128" />
                    </connections>
                </textField>
                <progressIndicator wantsLayer="YES" horizontalHuggingPriority="750" verticalHuggingPriority="750" minValue="16" maxValue="100" doubleValue="16" displayedWhenStopped="NO" bezeled="NO" indeterminate="YES" controlSize="small" style="spinning" translatesAutoresizingMaskIntoConstraints="NO" id="57">
                    <rect key="frame" x="264" y="47" width="16" height="16" />
                </progressIndicator>
                <button translatesAutoresizingMaskIntoConstraints="NO" id="122" userLabel="Hang Up Button">
                    <rect key="frame" x="265" y="44" width="15" height="21" />
                    <buttonCell key="cell" type="push" bezelStyle="rounded" borderStyle="border" imagePosition="noImage" alignment="center" imageScaling="proportionallyUpOrDown" inset="2" id="123" title="End Call">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                    </buttonCell>
                    <connections>
                        <action selector="hangUpCall:" target="-2" id="126" />
                    </connections>
                </button>
                <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" translatesAutoresizingMaskIntoConstraints="NO" id="number">
                    <rect key="frame" x="20" y="100" width="380" height="18" />
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" selectable="YES" title="" id="number-cell">
                        <font key="font" metaFont="system" size="13" />
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="callController.formattedNumber" id="number-binding" />
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" translatesAutoresizingMaskIntoConstraints="NO" id="duration">
                    <rect key="frame" x="20" y="100" width="380" height="18" />
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" selectable="YES" title="" id="duration-cell">
                        <font key="font" metaFont="system" size="13" />
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="callController.elapsedTime" id="duration-binding" />
                    </connections>
                </textField>
                <button translatesAutoresizingMaskIntoConstraints="NO" id="mute">
                    <rect key="frame" x="20" y="20" width="115" height="28" />
                    <buttonCell key="cell" id="mute-cell" type="push" bezelStyle="rounded" borderStyle="border" title="Mute" imagePosition="noImage">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                    </buttonCell>
                    <connections>
                        <action selector="toggleMicrophoneMute:" target="-2" id="mute-action" />
                    </connections>
                </button>
                <button translatesAutoresizingMaskIntoConstraints="NO" id="transfer">
                    <rect key="frame" x="20" y="20" width="115" height="28" />
                    <buttonCell key="cell" id="transfer-cell" type="push" bezelStyle="rounded" borderStyle="border" title="Transfer…" imagePosition="noImage">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                    </buttonCell>
                    <connections>
                        <action selector="showCallTransferSheet:" target="-2" id="transfer-action" />
                    </connections>
                </button>
            </subviews>
            <constraints>
                <constraint firstItem="59" firstAttribute="leading" constant="20" id="layout-0" secondItem="41" secondAttribute="leading" />
                <constraint firstItem="59" firstAttribute="top" constant="20" id="layout-1" secondItem="41" secondAttribute="top" />
                <constraint firstItem="59" firstAttribute="trailing" constant="-40" id="layout-2" secondItem="41" secondAttribute="trailing" />
                <constraint firstItem="number" firstAttribute="leading" constant="0" id="layout-3" secondItem="59" secondAttribute="leading" />
                <constraint firstItem="number" firstAttribute="top" constant="5" id="layout-4" secondItem="59" secondAttribute="bottom" />
                <constraint firstItem="number" firstAttribute="trailing" constant="-20" id="layout-5" secondItem="41" secondAttribute="trailing" />
                <constraint firstItem="61" firstAttribute="leading" constant="0" id="layout-6" secondItem="59" secondAttribute="leading" />
                <constraint firstItem="61" firstAttribute="top" constant="12" id="layout-7" secondItem="number" secondAttribute="bottom" />
                <constraint firstItem="61" firstAttribute="trailing" constant="-95" id="layout-8" secondItem="41" secondAttribute="trailing" />
                <constraint firstItem="duration" firstAttribute="trailing" constant="-20" id="layout-9" secondItem="41" secondAttribute="trailing" />
                <constraint firstItem="duration" firstAttribute="centerY" constant="0" id="layout-10" secondItem="61" secondAttribute="centerY" />
                <constraint firstItem="duration" firstAttribute="width" constant="70" id="layout-11" />
                <constraint firstItem="122" firstAttribute="trailing" constant="-20" id="layout-12" secondItem="41" secondAttribute="trailing" />
                <constraint firstItem="122" firstAttribute="bottom" constant="-20" id="layout-13" secondItem="41" secondAttribute="bottom" />
                <constraint firstItem="122" firstAttribute="width" constant="140" id="layout-14" />
                <constraint firstItem="mute" firstAttribute="leading" constant="20" id="layout-15" secondItem="41" secondAttribute="leading" />
                <constraint firstItem="mute" firstAttribute="centerY" constant="0" id="layout-16" secondItem="122" secondAttribute="centerY" />
                <constraint firstItem="mute" firstAttribute="width" constant="140" id="layout-17" />
                <constraint firstItem="transfer" firstAttribute="leading" constant="8" id="layout-18" secondItem="mute" secondAttribute="trailing" />
                <constraint firstItem="transfer" firstAttribute="centerY" constant="0" id="layout-19" secondItem="122" secondAttribute="centerY" />
                <constraint firstItem="transfer" firstAttribute="trailing" constant="-8" id="layout-20" secondItem="122" secondAttribute="leading" />
                <constraint firstItem="57" firstAttribute="trailing" constant="-20" id="layout-21" secondItem="41" secondAttribute="trailing" />
                <constraint firstItem="57" firstAttribute="centerY" constant="0" id="layout-22" secondItem="59" secondAttribute="centerY" />
            </constraints>
            <connections>
                <outlet property="delegate" destination="-2" id="101" />
            </connections>
            <point key="canvasLocation" x="6" y="135" />
        </customView>
    </objects>
    <resources>
        <image name="NSStopProgressFreestandingTemplate" width="20" height="20" />
    </resources>
</document>